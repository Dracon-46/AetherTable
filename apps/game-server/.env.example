NODE_ENV=development
PORT=2567

REDIS_URL="redis://localhost:6379"

# Precisa ser IDENTICO ao JWT_SECRET do backend-core.
# Segredos diferentes => "Invalid seat token" no handshake.
JWT_SECRET="a-MESMA-string-do-backend-core"

BACKEND_CORE_URL="http://localhost:3333"
PUBLIC_WS_URL="ws://localhost:2567"

# Presence/driver do Redis: opcional em dev de um no, OBRIGATORIO em producao multi-no.
USE_REDIS=false
