NODE_ENV=development
PORT=3333

DATABASE_URL="postgresql://postgres:password@localhost:5432/aethertable_db"
REDIS_URL="redis://localhost:6379"

JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ─── OAuth ───────────────────────────────────────────────────────────────────
#
# Opcional. Sem as DUAS variaveis de um provedor (id E segredo), a estrategia
# dele nao e registrada, `GET /auth/provedores` responde `false` e a tela de
# login NAO desenha o botao. Nao ha mais credencial de exemplo: um botao que
# leva a "The OAuth client was not found" do Google e pior que botao nenhum.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Endereco publico DESTA API, com o prefixo /api/v1. De onde saem as URLs de
# callback que voce cadastra no console do Google e do Discord:
#
#   <API_PUBLIC_URL>/auth/google/callback
#   <API_PUBLIC_URL>/auth/discord/callback
#
# Estava escrito a mao nas estrategias como `http://localhost:3333/...`, e nem
# `.env.example` nem `render.yaml` traziam a variavel — ou seja, em producao o
# provedor devolvia o usuario para a maquina do desenvolvedor.
API_PUBLIC_URL="http://localhost:3333/api/v1"

# So preencha se o provedor exigir um caminho de redirecionamento diferente do
# derivado acima. Tem precedencia sobre API_PUBLIC_URL.
# GOOGLE_CALLBACK_URL=
# DISCORD_CALLBACK_URL=

OAUTH_REDIRECT_BASE="http://localhost:3333/api/v1/auth/oauth"

# ─── E-mail (recuperacao de senha) ───────────────────────────────────────────
#
# SEM ESTA CHAVE: em desenvolvimento o link de redefinicao vai para o LOG do
# servidor (procure por "EmailService" na saida do `pnpm dev`) — da para testar
# o fluxo inteiro sem contratar nada. Em PRODUCAO a rota recusa com 503, em vez
# de responder "enviamos" sem ter enviado.
#
# E API HTTP e nao SMTP de proposito: o plano gratuito do Render BLOQUEIA trafego
# de saida nas portas 25, 465 e 587. Com nodemailer, o envio funcionaria na sua
# maquina e ficaria pendurado ate o timeout em producao.
RESEND_API_KEY=

# Remetente. O dominio precisa estar verificado no provedor.
# `onboarding@resend.dev` e o remetente de teste da Resend: entrega SO para o
# e-mail dono da conta, entao serve para o primeiro teste e nao serve para valer.
MAIL_FROM="AetherTable <onboarding@resend.dev>"

# Obrigatorio pela Scryfall. Sem isso: cartas sem imagem e bloqueio (DOC-035 §3).
SCRYFALL_USER_AGENT="AetherTable-dev/1.0 (seu-email@exemplo.com)"

# ─── Espelho da Scryfall (rotas /api/v1/cards/*) ─────────────────────────────
#
# O navegador NAO fala mais com `scryfall.io`: arte e metadados passam por esta
# API. Isso existe para redes que filtram dominios — escola, empresa, hospital —
# onde a chamada direta do navegador nem sai e a mesa aparece toda em branco.
#
# ATENCAO: quem precisa alcancar a Scryfall agora e o SERVIDOR. Se a API roda
# dentro da mesma rede filtrada, o problema so mudou de lugar. As duas variaveis
# abaixo permitem apontar para um espelho ou proxy que a rede libere.
# SCRYFALL_API_URL="https://api.scryfall.com"
# SCRYFALL_IMAGE_URL="https://cards.scryfall.io"

# Cache de arte em memoria, em MB. O plano gratuito do Render tem 512 MB no
# total; 64 segura umas 600 imagens `normal` sem chegar perto do teto.
CARD_IMAGE_CACHE_MB=64

# LiveKit — opcional; a mesa funciona sem voz
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

CORS_ORIGINS="http://localhost:3030"

# Para onde devolver o navegador depois do OAuth. Se ausente, cai em
# OAUTH_REDIRECT_BASE e depois na primeira origem de CORS_ORIGINS.
FRONTEND_URL="http://localhost:3030"

# Segredo das rotas maquina-a-maquina. `GET /api/v1/internal/decks/:id` devolve
# o decklist COMPLETO sem checar dono — e o que o game-server precisa e o que
# ninguem mais pode ler. Precisa ser IDENTICO ao do game-server.
# Em producao, sem este valor, a rota interna fecha.
INTERNAL_API_TOKEN="troque-por-uma-string-longa-e-aleatoria"

# ─────────────────────────────────────────────────────────────────────────────
# BACKOFFICE (DOC-061)
#
# Contas que DEVEM ser administradoras, separadas por virgula. A API reconcilia
# no boot: quem estiver nesta lista e ainda nao for ADMIN e promovido, com uma
# linha no log de auditoria registrando de onde veio a promocao.
#
# POR QUE ISTO EXISTE: toda rota que promove alguem a ADMIN exige um ADMIN
# autenticado. Numa base onde ninguem e admin — o estado de qualquer instalacao
# nova — o painel /admin e inalcancavel e a unica saida e um UPDATE manual no
# Postgres. Ver apps/backend-core/src/admin/admin-bootstrap.service.ts.
#
# NAO CRIA a conta (isso plantaria uma credencial previsivel) e NAO DESPROMOVE
# ninguem (uma env vazia num deploy mal configurado apagaria todos os
# administradores de uma vez, e o caminho de volta seria justamente o acesso
# manual ao banco que esta variavel existe para evitar).
ADMIN_EMAILS=""
