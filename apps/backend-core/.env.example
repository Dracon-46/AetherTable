NODE_ENV=development
PORT=3333

DATABASE_URL="postgresql://postgres:password@localhost:5432/aethertable_db"
REDIS_URL="redis://localhost:6379"

JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# OAuth — opcional em dev; sem isso, use login por e-mail/senha
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OAUTH_REDIRECT_BASE="http://localhost:3333/api/v1/auth/oauth"

# Obrigatorio pela Scryfall. Sem isso: cartas sem imagem e bloqueio (DOC-035 §3).
SCRYFALL_USER_AGENT="AetherTable-dev/1.0 (seu-email@exemplo.com)"

# ─── Espelho da Scryfall (rotas /api/v1/cards/*) ─────────────────────────────
#
# O navegador NAO fala mais com `scryfall.io`: arte e metadados passam por esta
# API. Isso existe para redes que filtram dominios — escola, empresa, hospital —
# onde a chamada direta do navegador nem sai e a mesa aparece toda em branco.
#
# ATENCAO: quem precisa alcancar a Scryfall agora e o SERVIDOR. Se a API roda
# dentro da mesma rede filtrada, o problema so mudou de lugar. As duas variaveis
# abaixo permitem apontar para um espelho ou proxy que a rede libere.
# SCRYFALL_API_URL="https://api.scryfall.com"
# SCRYFALL_IMAGE_URL="https://cards.scryfall.io"

# Cache de arte em memoria, em MB. O plano gratuito do Render tem 512 MB no
# total; 64 segura umas 600 imagens `normal` sem chegar perto do teto.
CARD_IMAGE_CACHE_MB=64

# LiveKit — opcional; a mesa funciona sem voz
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

CORS_ORIGINS="http://localhost:3030"

# Para onde devolver o navegador depois do OAuth. Se ausente, cai em
# OAUTH_REDIRECT_BASE e depois na primeira origem de CORS_ORIGINS.
FRONTEND_URL="http://localhost:3030"

# Segredo das rotas maquina-a-maquina. `GET /api/v1/internal/decks/:id` devolve
# o decklist COMPLETO sem checar dono — e o que o game-server precisa e o que
# ninguem mais pode ler. Precisa ser IDENTICO ao do game-server.
# Em producao, sem este valor, a rota interna fecha.
INTERNAL_API_TOKEN="troque-por-uma-string-longa-e-aleatoria"
