// AetherTable — schema do banco.
// Fonte canonica: docs/modelo_de_dados.md (DOC-023).
//
// PRINCIPIO CENTRAL (§1.2): nao armazenamos textos, regras nem imagens de carta.
// Guardamos estritamente o `scryfall_id`. A base do MTG tem 25.000+ oracle cards
// e 90.000+ printings, e cresce a cada dois meses — manter copia significaria
// manter sincronizacao, alem de levantar discussao sobre redistribuicao.
//
// Mapeamento: snake_case no banco, camelCase no cliente.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  MOD
  ADMIN
}

/// ─── DIREITO A COSMETICO DE APOIADOR ──────────────────────────────────────────
///
/// O catalogo (`shared-types/cosmetics.ts`, DOC-060) marca itens como `FREE` ou
/// `APOIADOR`, e a interface desenhava um CADEADO nos de apoiador. O cadeado era
/// decorativo: o botao nao tinha `disabled`, o DTO validava so a existencia do id
/// no catalogo, e `updateUser` gravava direto. Qualquer conta equipava qualquer
/// coisa.
///
/// Nao existe pagamento neste repositorio — zero ocorrencias de Patreon, Stripe
/// ou checkout. Entao o tier e ADMINISTRADO PELO BACKOFFICE, que ja tem tela de
/// usuarios e trilha de auditoria. Quando houver integracao de pagamento, ela
/// escreve nesta mesma coluna e nada mais muda.
///
/// A alternativa era tornar o catalogo inteiro gratuito e remover o cadeado. Foi
/// descartada porque joga fora a estrutura de monetizacao ja modelada em DOC-060
/// — e reintroduzi-la depois seria refazer o catalogo.
enum SupporterTier {
  FREE
  APOIADOR
}

enum Provider {
  GOOGLE
  DISCORD
}

// NOTA: formato NAO e enum. Ha 45+ formatos e novos surgem a cada colecao.
// `Deck.formatId` e um VarChar que referencia `FormatPreset.id`, versionado no
// codigo, nao no banco (DOC-037 §9.1).

enum BoardType {
  MAIN
  SIDEBOARD
  COMMANDER
  MAYBEBOARD
  SIGNATURE_SPELL
  CUBE
  PLANAR
  SCHEME
  VANGUARD
  ATTRACTION
  CONTRAPTION
  STICKER
}

enum Theme {
  DARK
  LIGHT
  SYSTEM
}

enum VoiceMode {
  VAD
  PTT
}

enum CosmeticType {
  PLAYMAT
  SLEEVE
  BORDER
  TITLE
}

enum ReportReason {
  HARASSMENT
  CHEATING
  SPAM
  HATE_SPEECH
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

/// Toda acao do backoffice que muda algo. O enum e fechado de proposito: o log
/// de auditoria precisa ser AGRUPAVEL e FILTRAVEL, e uma string livre viraria
/// vinte grafias da mesma acao em seis meses (DOC-061 §6).
enum AdminAction {
  USER_SUSPEND
  USER_UNSUSPEND
  USER_BAN
  USER_RESTORE
  USER_ROLE_CHANGE
  INVENTORY_GRANT
  INVENTORY_REVOKE
  COSMETIC_CREATE
  COSMETIC_UPDATE
  COSMETIC_DELETE
  REPORT_CLAIM
  REPORT_RESOLVE
  REPORT_DISMISS
  FLAG_CHANGE
  CARD_CACHE_PURGE
}

// ─── Usuario e identidade ─────────────────────────────────────────────────────

model User {
  id       String @id @default(uuid()) @db.Uuid
  email    String @unique @db.VarChar(255)
  /// ^[a-zA-Z0-9_]{3,32}$
  username String @unique @db.VarChar(32)
  /// Nome exibido na mesa; cai para `username` quando nulo.
  displayName String? @map("display_name") @db.VarChar(48)
  /// Argon2id. NULO quando a conta e exclusivamente OAuth.
  passwordHash    String?   @map("password_hash") @db.VarChar(255)
  avatarUrl       String?   @map("avatar_url")
  role            Role      @default(USER)
  /// Direito a cosmetico de apoiador. Ver o enum: administrado pelo backoffice
  /// enquanto nao houver integracao de pagamento.
  supporterTier   SupporterTier @default(FREE) @map("supporter_tier")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  lastSeenAt      DateTime? @map("last_seen_at") @db.Timestamptz
  /// Soft delete para LGPD: expurgo fisico em 30 dias (§7.1).
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  /// SUSPENSAO TEMPORARIA (DOC-061 §2).
  ///
  /// Uma DATA, e nao um booleano `suspended`: suspensao tem prazo, e um
  /// booleano exigiria alguem (ou um cron) para desligar. Com a data, a
  /// suspensao expira sozinha e o login volta a funcionar sem intervencao —
  /// que e a diferenca entre "suspenso por 7 dias" e "banido ate alguem
  /// lembrar".
  suspendedUntil   DateTime? @map("suspended_until") @db.Timestamptz
  /// O motivo mostrado ao usuario na tentativa de login.
  suspensionReason String?   @map("suspension_reason")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  decks        Deck[]
  accounts     Account[]
  preference   UserPreference?
  blocksMade   Block[]           @relation("blocker")
  blocksGot    Block[]           @relation("blocked")
  reportsMade  Report[]          @relation("reporter")
  reportsGot   Report[]          @relation("reported")
  cosmetics    UserCosmetic[]
  participions MatchParticipant[]

  auditActions    AuditLog[] @relation("auditActor")
  reportsResolved Report[]   @relation("reportResolver")

  @@index([deletedAt])
  @@index([role])
  @@index([suspendedUntil])
  @@map("users")
}

/// Vinculo OAuth. NAO armazenamos access/refresh token do provedor: usamos OAuth
/// apenas para identificar, nunca para agir em nome do usuario (RN11).
model Account {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          Provider
  providerAccountId String   @map("provider_account_id") @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Permite vincular Google E Discord a mesma conta sem duplicar usuario.
  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model UserPreference {
  userId String @id @map("user_id") @db.Uuid

  /// JSONB porque o conjunto de acoes mapeaveis muda a cada versao, e nunca
  /// filtramos por atalho — normalizar geraria migracao a cada atalho novo.
  keybindings Json @default("{}")

  theme            Theme     @default(DARK)
  /// ─── FK PARA `CosmeticItem`. NAO E ONDE O EQUIPAMENTO VIVE. ──────────────
  ///
  /// Estas quatro colunas sao `Uuid` e apontam para `cosmetic_items` — o
  /// registro de itens CONCEDIVEIS (o premio de campeonato de DOC-061 §2).
  /// Elas nunca foram escritas por ninguem, e nao por desleixo: os cosmeticos
  /// que o jogo desenha vem do catalogo PROCEDURAL em codigo
  /// (`shared-types/cosmetics.ts`, DOC-060 §1.1) e tem id de texto —
  /// 'aether-classic', 'mesa-padrao'. Uma string dessas nao entra num Uuid.
  ///
  /// Ficam para o dia em que o inventario concedido virar equipavel. O
  /// equipamento de verdade mora nas colunas de texto abaixo.
  activePlaymatId  String?   @map("active_playmat_id") @db.Uuid
  activeSleeveId   String?   @map("active_sleeve_id") @db.Uuid
  activeBorderId   String?   @map("active_border_id") @db.Uuid
  activeTitleId    String?   @map("active_title_id") @db.Uuid

  /// ─── O EQUIPAMENTO, POR CONTA ────────────────────────────────────────────
  ///
  /// Os cosmeticos so existiam em `localStorage`. Trocar de navegador, limpar
  /// dados do site ou entrar de outra maquina perdia tudo — foi o relato "os
  /// cosmeticos nao estao sendo salvos".
  ///
  /// VarChar e nao FK: o catalogo e fechado e versionado em codigo, entao a
  /// validacao de um id e `ehSleeveValido()` e nao uma foreign key. Um id que
  /// sai do catalogo cai no padrao pelo `acharSleeve`, sem migracao e sem
  /// linha orfa no banco.
  ///
  /// `localStorage` CONTINUA sendo o caminho rapido: a mesa nao pode esperar um
  /// round-trip de API para saber com que sleeve desenhar as cartas. O banco e
  /// a fonte da verdade entre dispositivos; o cache local e o que faz a mesa
  /// abrir sem piscar.
  sleeveId  String? @map("sleeve_id") @db.VarChar(48)
  playmatId String? @map("playmat_id") @db.VarChar(48)
  borderId  String? @map("border_id") @db.VarChar(48)
  titleId   String? @map("title_id") @db.VarChar(48)
  petId     String? @map("pet_id") @db.VarChar(48)
  /// Acessibilidade (DOC-060 §4): desligar o visual dos outros na minha tela.
  cosmeticosDeOponentes Boolean @default(true) @map("cosmeticos_de_oponentes")
  voiceMode        VoiceMode @default(VAD)
  pttKey           String?   @map("ptt_key") @db.VarChar(24)
  /// 0..100
  masterVolume Int    @default(100) @map("master_volume") @db.SmallInt
  language     String @default("pt-BR") @db.VarChar(8)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activePlaymat CosmeticItem? @relation("playmat", fields: [activePlaymatId], references: [id])
  activeSleeve  CosmeticItem? @relation("sleeve", fields: [activeSleeveId], references: [id])
  activeBorder  CosmeticItem? @relation("border", fields: [activeBorderId], references: [id])
  activeTitle   CosmeticItem? @relation("title", fields: [activeTitleId], references: [id])

  @@map("user_preferences")
}

// ─── Decks ────────────────────────────────────────────────────────────────────

model Deck {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  name        String  @db.VarChar(80)
  description String?
  /// scryfall_id do comandante.
  commanderId String? @map("commander_id") @db.VarChar(36)
  /// Segundo comandante (Partner / Background).
  partnerId String? @map("partner_id") @db.VarChar(36)
  /// Referencia FormatPreset.id. Nao e enum — ver nota no topo.
  formatId   String   @default("commander") @map("format_id") @db.VarChar(32)
  isPublic   Boolean  @default(false) @map("is_public")
  isFavorite Boolean  @default(false) @map("is_favorite")
  /// DESNORMALIZADO: soma de `quantity`. A listagem de decks e a tela mais
  /// visitada; somar a cada carregamento e desperdicio. Atualizado na MESMA
  /// transacao que altera as cartas.
  cardCount     Int      @default(0) @map("card_count")
  colorIdentity String[] @default([]) @map("color_identity")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards DeckCard[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([isPublic])
  @@map("decks")
}

/// Exatamente o que FR-04 exige: apenas scryfall_id, quantity, is_commander e
/// board_type. Nome, texto e imagem NUNCA aqui.
model DeckCard {
  id     String @id @default(uuid()) @db.Uuid
  deckId String @map("deck_id") @db.Uuid
  /// Referencia ABSOLUTA de impressao — define arte, edicao e idioma.
  scryfallId String @map("scryfall_id") @db.VarChar(36)
  /// 1..99 (CHECK aplicado por migracao manual).
  quantity    Int       @default(1)
  isCommander Boolean   @default(false) @map("is_commander")
  boardType   BoardType @default(MAIN) @map("board_type")
  sortOrder   Int       @default(0) @map("sort_order")

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  /// Uma linha por impressao por secao; quantidades vao em `quantity`, nunca em
  /// linhas repetidas.
  @@unique([deckId, scryfallId, boardType])
  @@index([deckId])
  @@index([scryfallId])
  @@map("deck_cards")
}

// ─── Cache derivavel da Scryfall ──────────────────────────────────────────────

/// Tabela DESCARTAVEL: um TRUNCATE nao perde nada de valor — o job de bulk data
/// a reconstroi. Por isso nao tem FK apontando para ela e nao participa de
/// transacoes criticas.
model CardCache {
  scryfallId     String   @id @map("scryfall_id") @db.VarChar(36)
  oracleId       String   @map("oracle_id") @db.VarChar(36)
  name           String   @db.VarChar(255)
  setCode        String   @map("set_code") @db.VarChar(10)
  collectorNum   String   @map("collector_num") @db.VarChar(16)
  lang           String   @default("en") @db.VarChar(8)
  cmc            Float    @default(0)
  typeLine       String   @default("") @map("type_line")
  manaCost       String   @default("") @map("mana_cost") @db.VarChar(64)
  colorIdentity  String[] @default([]) @map("color_identity")
  legalCommander Boolean  @default(false) @map("legal_commander")
  layout         String   @default("normal") @db.VarChar(32)
  imageSmall     String   @default("") @map("image_small")
  imageNormal    String   @default("") @map("image_normal")
  /// Faces de DFC / split / adventure. Cartas de dupla face nao tem image_uris
  /// na raiz (DOC-035 §2.2).
  faces     Json     @default("[]")
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz

  @@index([oracleId])
  @@index([name])
  @@map("card_cache")
}

// ─── Moderacao ────────────────────────────────────────────────────────────────

model Block {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  /// CHECK (blocker_id <> blocked_id) aplicado por migracao manual.
  @@id([blockerId, blockedId])
  @@map("blocks")
}

model Report {
  id         String       @id @default(uuid()) @db.Uuid
  reporterId String       @map("reporter_id") @db.Uuid
  reportedId String       @map("reported_id") @db.Uuid
  roomCode   String?      @map("room_code") @db.VarChar(6)
  reason     ReportReason
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz

  /// EVIDENCIA CONGELADA (DOC-061 §4).
  ///
  /// As ultimas linhas de log e chat, capturadas no momento da denuncia. Tem de
  /// ser um snapshot e nao uma referencia: o estado da sala vive na RAM do game
  /// node (ADR-006, RN12) e desaparece quando a partida acaba. Sem copiar aqui,
  /// toda denuncia chegaria ao moderador sem nada para analisar.
  ///
  /// Audio NAO e gravado — ofensa verbal depende de denuncias multiplas para
  /// gerar padrao, como o documento preve.
  snapshot Json @default("[]")

  /// Resolucao. `resolvedById` e SetNull para a auditoria sobreviver ao expurgo
  /// da conta do moderador.
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz
  resolvedById String?   @map("resolved_by_id") @db.Uuid
  /// O que o moderador decidiu, em texto livre. Fica visivel na fila.
  resolution String?

  reporter   User  @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User  @relation("reported", fields: [reportedId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("reportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  /// DEDUPLICACAO FICA NA APLICACAO, E NAO NUM INDICE UNICO.
  ///
  /// A intencao e clara — uma pessoa nao empilha dez denuncias da mesma conduta
  /// na mesma sala — mas um `@@unique` sobre estas quatro colunas nao entrega
  /// isso, por duas razoes que se somam:
  ///
  ///   1. `room_code` e ANULAVEL (denuncia feita fora de partida). No Postgres,
  ///      NULLs sao DISTINTOS num indice unico: duas denuncias sem sala nao
  ///      colidem. A garantia falharia exatamente no caso mais aberto a abuso.
  ///   2. O Prisma nao aceita `findUnique`/`upsert` sobre um unique composto que
  ///      contenha coluna anulavel, porque a chave gerada exige todos os campos
  ///      nao-nulos. O codigo teria de contornar o proprio indice.
  ///
  /// Entao o indice aqui e de BUSCA, e a deduplicacao vive em
  /// `AdminDenunciasService.criar` — onde `room_code` nulo pode ser comparado
  /// com `null` de verdade. O risco que sobra e uma corrida entre dois cliques
  /// simultaneos do mesmo usuario, cujo pior resultado e um item repetido na
  /// fila. Aceitavel: o moderador descarta em um clique.
  @@index([reporterId, reportedId, reason])
  @@index([reportedId])
  @@index([status, createdAt(sort: Desc)])
  @@map("reports")
}

// ─── Estatistica agregada ─────────────────────────────────────────────────────

/// DELIBERADAMENTE POBRE. Nao guarda estado de jogo, jogadas, decks nem quem
/// ganhou — apenas o suficiente para "partidas jogadas" no perfil (RF02).
/// Consistente com RN12 e ADR-006. Sobrevive a exclusao de conta porque nao
/// contem dado pessoal.
model MatchSummary {
  id              String   @id @default(uuid()) @db.Uuid
  roomCode        String   @map("room_code") @db.VarChar(6)
  playerCount     Int      @map("player_count") @db.SmallInt
  durationSeconds Int      @map("duration_seconds")
  endedAt         DateTime @map("ended_at") @db.Timestamptz

  participants MatchParticipant[]

  @@index([endedAt])
  @@map("match_summaries")
}

/// Unica tabela que associa usuario e partida. `userId` vira NULL no expurgo de
/// 30 dias, preservando a estatistica agregada anonimizada.
model MatchParticipant {
  /// PK propria em vez de @@id([matchId, userId]): `userId` PRECISA ser nullable
  /// para o expurgo de 30 dias (§7.1), e o Prisma nao aceita campo opcional em
  /// definicao de id.
  id      String  @id @default(uuid()) @db.Uuid
  matchId String  @map("match_id") @db.Uuid
  userId  String? @map("user_id") @db.Uuid

  match MatchSummary @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// No Postgres, NULLs nao colidem em UNIQUE — o que aqui e desejado: os quatro
  /// participantes anonimizados da mesma partida coexistem apos o expurgo.
  @@unique([matchId, userId])
  @@index([userId])
  @@map("match_participants")
}

// ─── Backoffice (DOC-061) ─────────────────────────────────────────────────────

/// RASTRO INALTERAVEL de toda acao administrativa (DOC-061 §6).
///
/// O checklist de seguranca do documento pede que TODO endpoint do modulo admin
/// gere uma linha aqui. O modulo nao tinha endpoint nenhum, e a tabela nao
/// existia — quer dizer, promover um usuario a ADMIN ou apagar uma conta era
/// uma escrita sem testemunha.
///
/// NADA aqui e editavel ou apagavel pela aplicacao: nao existe rota de update
/// nem de delete. Um log de auditoria que o proprio admin pode limpar responde
/// a pergunta errada.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// Quem fez. SetNull no expurgo da conta (§7.1) — o rastro sobrevive ao autor.
  actorId String? @map("actor_id") @db.Uuid

  /// O username de quem fez, CONGELADO no momento da acao.
  ///
  /// Redundante com a relacao de proposito: `actorId` vira NULL no expurgo, e
  /// um username muda. Sem a copia, o historico viraria "alguem suspendeu
  /// alguem", que e o mesmo que nao ter historico.
  actorLabel String @map("actor_label") @db.VarChar(64)

  action AdminAction

  /// Sobre o que a acao foi: 'user', 'cosmetic', 'report', 'flag', 'system'.
  targetType String  @map("target_type") @db.VarChar(24)
  targetId   String? @map("target_id") @db.VarChar(64)
  /// Rotulo legivel do alvo, tambem congelado.
  targetLabel String? @map("target_label") @db.VarChar(160)

  /// Justificativa que o admin digitou. Obrigatoria nas acoes punitivas.
  reason String?
  /// Detalhe estruturado da acao (role anterior e nova, dias de suspensao...).
  metadata Json @default("{}")
  /// IP de origem, para investigar acesso indevido a conta administrativa.
  ip String? @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation("auditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

/// Interruptor global de plataforma (DOC-061 §5).
///
/// O documento pede um "Kill Switch de Voz": um botao de emergencia que
/// desabilita o LiveKit para todo mundo se o faturamento do SFU disparar ou
/// houver abuso. Uma variavel de ambiente nao serve para isso — mudar env exige
/// redeploy, e uma emergencia de faturamento nao espera build.
///
/// Tabela e nao JSON num registro so: cada flag tem historico de quem mexeu.
model PlatformFlag {
  key         String   @id @db.VarChar(48)
  enabled     Boolean  @default(true)
  /// Por que esta assim. Aparece no painel, ao lado do interruptor.
  note        String?
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.VarChar(64)

  @@map("platform_flags")
}

// ─── Cosmeticos e monetizacao (DOC-060) ──────────────────────────────────────

/// ─── TOKENS REVOGADOS (o logout que desloga) ─────────────────────────────────
///
/// `POST /auth/logout` era `return;` — corpo vazio. Nao revogava nada, e o
/// frontend nem o chamava: `handleLogout` so limpava o localStorage. Com o
/// access token valendo 24h e sem denylist, SAIR DA CONTA DEIXAVA UM TOKEN
/// VALIDO POR ATE UM DIA. Quem tivesse copiado o token — de um log de proxy, do
/// historico do navegador, de uma maquina compartilhada — continuava dentro.
///
/// Uma linha por logout, apagada quando o token expira: a tabela nunca cresce
/// alem dos tokens vivos.
///
/// POR QUE TABELA E NAO REDIS: o Redis e OPCIONAL neste projeto (`USE_REDIS`,
/// e so no game-server). Uma trava de seguranca que so funciona quando um
/// servico opcional esta de pe nao e uma trava. Se a consulta virar gargalo,
/// o Redis entra como cache na frente desta tabela — nao no lugar dela.
model RevokedToken {
  /// O `jti` do access token. Nao ha FK: o token pode sobreviver a conta.
  jti       String   @id @db.VarChar(64)
  userId    String   @map("user_id") @db.Uuid
  /// Quando o proprio token expiraria. Depois disto a linha e lixo.
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  revokedAt DateTime @default(now()) @map("revoked_at") @db.Timestamptz

  @@index([expiresAt])
  @@map("revoked_tokens")
}

model CosmeticItem {
  id          String       @id @default(uuid()) @db.Uuid
  type        CosmeticType
  name        String       @db.VarChar(64)
  /// URL de imagem ou classe CSS.
  resourceUrl String? @map("resource_url")
  /// Nivel de apoiador necessario.
  minTier  Int     @default(0) @map("min_tier")
  isActive Boolean @default(true) @map("is_active")

  ownedBy      UserCosmetic[]
  asPlaymatFor UserPreference[] @relation("playmat")
  asSleeveFor  UserPreference[] @relation("sleeve")
  asBorderFor  UserPreference[] @relation("border")
  asTitleFor   UserPreference[] @relation("title")

  @@index([type])
  @@map("cosmetic_items")
}

model UserCosmetic {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  cosmeticId String   @map("cosmetic_id") @db.Uuid
  acquiredAt DateTime @default(now()) @map("acquired_at") @db.Timestamptz

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmetic CosmeticItem @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  @@unique([userId, cosmeticId])
  @@index([userId])
  @@map("user_cosmetics")
}
