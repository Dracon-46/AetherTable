{
  "name": "aethertable",
  "version": "0.10.1",
  "private": true,
  "description": "AetherTable — plataforma web sandbox multiformato para Magic: The Gathering. Nao existe motor de regras: o sistema move pecas, sincroniza estado e esconde informacao.",
  "author": "Falkyria",
  "homepage": "https://github.com/Dracon-46/AetherTable#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dracon-46/AetherTable.git"
  },
  "bugs": {
    "url": "https://github.com/Dracon-46/AetherTable/issues"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0 <23",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:kill": "node tools/kill-dev.mjs",
    "dev:turbo": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "verificar": "node tools/verificar.mjs",
    "test:watch": "turbo run test:watch",
    "test:e2e": "pnpm --filter frontend test:e2e",
    "lint": "turbo run lint && pnpm lint:raiz",
    "lint:raiz": "eslint tools --max-warnings=0",
    "lint:fix": "turbo run lint -- --fix && eslint tools --fix",
    "typecheck": "turbo run typecheck",
    "schema:sync": "node tools/schema-sync.mjs",
    "schema:check": "node tools/schema-sync.mjs --check",
    "docs:estado": "node tools/estado-implementacao.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "db:migrate": "pnpm --filter backend-core db:migrate",
    "db:reset": "pnpm --filter backend-core db:reset",
    "db:seed": "pnpm --filter backend-core db:seed",
    "db:studio": "pnpm --filter backend-core db:studio",
    "load-test": "k6 run tools/load/room-join.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@next/eslint-plugin-next": "15.5.23",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@colyseus/greeting-banner": "^3.0.8",
      "proxy-addr@<2.0.8": "^2.0.8",
      "qs@<6.16.0": "^6.16.0",
      "js-yaml@>=5 <5.4.1": "^5.4.1",
      "next>postcss": "^8.5.31",
      "next>sharp": "^0.35.5",
      "source-map-js@<1.2.2": "^1.2.2"
    }
  }
}
