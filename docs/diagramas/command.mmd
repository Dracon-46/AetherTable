%% AetherTable — DOC-097 — Padrao Command no desfazer da mesa
%% Fonte: apps/game-server/src/intents/comandos.ts
classDiagram
    direction LR

    class ComandoDeMesa {
        <<interface>>
        +tipo: string
        +autor: string
        +executar() void
        +reversivel() boolean
        +desfazer() void
    }

    class ComandoDeIntencao {
        <<comando concreto>>
        -handler: IntentHandler
        -ctx: IntentContext
        -dados: unknown
        -state: RoomState
        -memento: MementoDoRecorte
        -recorte: RecorteDoJogador
        +executar() void
        +reversivel() boolean
        +desfazer() void
    }

    class HistoricoDeComandos {
        <<invoker>>
        -ultimo: Map~sid, comando+em~
        +executar(comando, agora) void
        +desfazer(sid, agora) string
        +esquecer(sid) void
    }

    class AetherRoom {
        <<cliente>>
        +onMessage(tipo) void
        monta o comando e entrega
    }

    class IntentHandler {
        <<receiver>>
        +schema
        +autoriza
        +executa(ctx, payload) void
    }

    class MementoDoRecorte {
        <<memento - ver DOC-098>>
        +autor: string
        +tipo: string
        +em: number
    }

    class RecorteDoJogador {
        <<originator - services/undo.ts>>
        +salvar(tipo, agora) MementoDoRecorte
        +restaurar(memento) void
    }

    ComandoDeMesa <|.. ComandoDeIntencao
    HistoricoDeComandos o-- ComandoDeMesa : guarda o ultimo por jogador
    AetherRoom ..> ComandoDeIntencao : cria
    AetherRoom ..> HistoricoDeComandos : executar / desfazer
    ComandoDeIntencao --> IntentHandler : executa
    ComandoDeIntencao --> MementoDoRecorte : guarda sem abrir
    ComandoDeIntencao --> RecorteDoJogador : salvar e restaurar
    RecorteDoJogador ..> MementoDoRecorte : produz
